# BulletBoost Frontend Environment Configuration Template
# Base URL of the Python FastAPI backend service (IPv4 loopback)
VITE_API_BASE_URL=http://127.0.0.1:8000

# NOTE: If you modify VITE_API_BASE_URL, you MUST restart the Vite dev server
# (Ctrl+C and run "npm run dev") for the new value to take effect.
# Do not store server-side secrets or sensitive credentials in frontend environment variables.
